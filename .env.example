# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# Admin Telegram Numeric User ID
ADMIN_ID=123456789

# Admin UPI ID for payments
ADMIN_UPI_ID=yourname@okaxis

# Database file location
DB_PATH=stranger_chat.db

# Minimum account age restriction in days (default: 30)
MIN_ACCOUNT_AGE_DAYS=30

# Webhook configuration for Render / Cloud Web Services
PORT=8080
WEBHOOK_URL=https://your-service-name.onrender.com
